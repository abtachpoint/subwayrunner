# Fill these in the deployment secret manager; this file contains no credentials.
PLAY_PACKAGE_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
# Alternatively inject a short-lived OAuth access token through workload identity.
GOOGLE_PLAY_ACCESS_TOKEN=
PURCHASE_TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=/var/lib/subway-runner/purchases.sqlite3
BIND_HOST=127.0.0.1
PORT=8080
